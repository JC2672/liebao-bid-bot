# Python
backend/.venv/
backend/**/__pycache__/
*.pyc
backend/*.egg-info/

# Node
web/node_modules/
web/dist/
extension/node_modules/
extension/.output/
extension/.wxt/

# App data (local, per-machine)
data/
*.db
*.db-journal

# Real profiles (name, email, phone, your actual resume prompt) - personal
# data, never committed. Templates live separately under backend/templates/
# (shared, non-personal design assets) and stay tracked.
backend/profiles/*/

# Secrets / config
.env
**/settings.local.json

# Internal design/architecture doc - kept locally, not shared via the repo
docs/ARCHITECTURE.md

# Editor/OS
.DS_Store
Thumbs.db

# playwright-cli scratch output (snapshots, screenshots) from manual testing
.playwright-cli/
*.playwright-cli/
